{
  "manifest_version": 3,
  "name": "BrowserGuard",
  "version": "1.0.0",
  "description": "Local-first protection from phishing, risky pages, ads and trackers.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["worker.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browserguard@example.org",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_title": "Open BrowserGuard Dashboard"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "privacy_filters",
        "enabled": true,
        "path": "rules/privacy.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["warning.html", "warning.css", "warning.js"],
      "matches": ["<all_urls>"]
    }
  ]
}